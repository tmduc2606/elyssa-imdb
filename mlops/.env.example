# Required — set a secure password for PostgreSQL
POSTGRES_PASSWORD=changeme

# Required — set a secure password for Grafana
GRAFANA_PASSWORD=changeme

# Required — set a secure secret key for RustFS
RUSTFS_SECRET_KEY=changeme

# API / Model Service env vars (optional overrides)
ELYSSA_JWT_SECRET=
ELYSSA_SECURE_COOKIES=false
ELYSSA_DEBUG=true
ELYSSA_RATE_LIMIT_PER_MINUTE=200
ELYSSA_GOLD_MARTS_PATH=/data/marts/processed
ELYSSA_DATABASE_URL=sqlite:///data/elyssa.db
ELYSSA_REDIS_URL=redis://redis:6379/0

# Optional overrides (defaults shown)
POSTGRES_USER=elyssa
POSTGRES_DB=elyssa_warehouse
GRAFANA_USER=admin
RUSTFS_ACCESS_KEY=elyssa
