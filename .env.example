# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=elyssa
POSTGRES_PASSWORD=elyssa_pg_2026
POSTGRES_DB=elyssa_warehouse

# ─── Neo4j ──────────────────────────────────────────────────
NEO4J_AUTH=neo4j/elyssa_neo_2026

# ─── RustFS (S3-compatible) ─────────────────────────────────
RUSTFS_ACCESS_KEY=elyssa
RUSTFS_SECRET_KEY=elyssa_s3_2026
RUSTFS_API_PORT=9100
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=elyssa
S3_SECRET_KEY=elyssa_s3_2026
S3_REGION=us-east-1

# ─── Gold Export (used by export_marts.py + GoldExportOperator)
GOLD_EXPORT_PG_HOST=postgres
GOLD_EXPORT_PG_PORT=5432
GOLD_EXPORT_PG_DB=elyssa_warehouse
GOLD_EXPORT_PG_USER=elyssa
GOLD_EXPORT_PG_PASSWORD=elyssa_pg_2026
GOLD_EXPORT_DIR=/opt/airflow/output/gold/

# ─── Airflow ────────────────────────────────────────────────
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://elyssa:elyssa_pg_2026@postgres:5432/elyssa_warehouse

# ─── Web Application ────────────────────────────────────────
ELYSSA_GOLD_MARTS_PATH=/data/marts/full
ELYSSA_MODEL_ARTIFACTS_PATH=/data/marts/processed
ELYSSA_DATABASE_URL=sqlite:///data/elyssa.db
ELYSSA_DEBUG=false
ELYSSA_REDIS_ENABLED=true
ELYSSA_REDIS_URL=redis://redis:6379/0
ELYSSA_RATE_LIMIT_PER_MINUTE=200
ELYSSA_JWT_SECRET=dev-secret-change-in-production-32bytes!
