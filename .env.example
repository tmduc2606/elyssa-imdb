# Elyssa-IMDb — environment template
# Copy to `.env` and fill in real values. Never commit the real .env.

# ─── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_USER=elyssa
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=elyssa_warehouse

# ─── RustFS (S3-compatible Bronze storage) ────────────────────────────
RUSTFS_ACCESS_KEY=elyssa
RUSTFS_SECRET_KEY=change-me-in-production

# ─── Grafana ──────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-in-production

# ─── OpenPosterDB (poster image service) ──────────────────────────────
ELYSSA_POSTER_API_KEY=t0-free-rpdb
