# Runtime SQLite databases (generated by MLflow, DuckDB)
*.db
*.db.wal

# MLflow artifacts
mlruns/
mlartifacts/

# CatBoost training info
catboost_info/

# Generated figures (EDA, modeling, analytics outputs)
figures/

# Binary model artifacts (also covered by root .gitignore)
*.pkl
*.joblib
*.h5
*.keras
*.pt
*.pth
*.onnx
*.cbm
*.parquet
*.npy

# Notebook-generated model artifacts directory
# Binary files are ignored above; JSON metadata and SQL queries are tracked
notebooks/models/
!notebooks/models/**/*.json
!notebooks/models/**/*.sql
