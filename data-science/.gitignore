# Runtime SQLite databases (generated by MLflow, DuckDB)
*.db
*.db.wal

# MLflow artifacts
mlruns/
mlartifacts/

# CatBoost training info
catboost_info/

# Generated figures (EDA, modeling, analytics outputs)
# Track PNG portfolio assets; ignore everything else (html, temp, empty dirs)
figures/*
!figures/eda/
!figures/modeling/
!figures/analytics/
figures/eda/*
!figures/eda/*.png
figures/modeling/*
!figures/modeling/*.png
figures/analytics/*
!figures/analytics/*.png

# Binary model artifacts (also covered by root .gitignore)
*.pkl
*.joblib
*.h5
*.keras
*.pt
*.pth
*.onnx
*.cbm
*.parquet
*.npy

# Notebook-generated model artifacts directory
# Binary files are ignored above; JSON metadata and SQL queries are tracked
notebooks/models/
!notebooks/models/**/*.json
!notebooks/models/**/*.sql

# Elyssa pipeline runtime marts (generated by Docker pipeline layers)
# Bronze/Silver/Gold parquet + checkpoint markers + manifests
marts/*
!marts/gold/
!marts/gold/_MANIFEST.json
marts/gold/*
!marts/gold/_MANIFEST.json

# CI test fixtures (committed so GitHub Actions can validate without runtime marts)
!tests/fixtures/
!tests/fixtures/gold/
!tests/fixtures/gold/*.parquet
!tests/fixtures/processed/
!tests/fixtures/processed/*.json
!tests/fixtures/processed/*.joblib
!tests/fixtures/processed/*.pt
!tests/fixtures/processed/*.cbm
