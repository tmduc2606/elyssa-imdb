# Runtime SQLite databases (generated by MLflow, DuckDB)
*.db
*.db.wal

# MLflow artifacts
mlruns/
mlartifacts/

# CatBoost training info
catboost_info/

# Pre-packaged sample data (generated by generate_sample_data.py)
marts/sample/
marts/sample_processed/

# Feature cache (generated during pipeline runs)
*.npy
*.parquet
*.joblib

# Exclude the processed dir but not its .gitkeep
marts/processed/*
!marts/processed/.gitkeep

# PyTorch models
*.pt
*.pth

# CatBoost models
*.cbm
