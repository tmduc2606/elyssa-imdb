# Elyssa-IMDb | Data Engineering Stack — Docker Images
# Neo4j Graph Database for relationship traversals & Cypher MERGE

# ─── Neo4j Community ───────────────────────────────────────────────
# Purpose: Graph layer — title/principal relationships, episodic content
# Port: 7474 (HTTP), 7687 (Bolt)
FROM neo4j:community

# Environment
# NOTE: placeholder auth only — this service is dormant (not referenced by
# docker/docker-compose.yml). Real deployments must override NEO4J_AUTH at
# runtime via compose environment from docker/.env (C1-C7).
ENV NEO4J_AUTH=neo4j/change-me-neo4j-password \
    NEO4J_server_memory_heap_max__size=1G \
    NEO4J_server_memory_pagecache_size=1G \
    NEO4J_PLUGINS='["apoc"]'

# Health check
HEALTHCHECK --interval=15s --timeout=10s --retries=5 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:7474 || exit 1

EXPOSE 7474 7687
