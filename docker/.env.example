# Elyssa-IMDb | Docker Environment Variables
# Copy to .env and adjust as needed. DO NOT commit .env to VCS.
# Ports are pre-allocated across ALL phases to prevent conflicts.
#
# ┌──────────────────────────────────────────────────────────────────┐
# │ PORT REGISTRY — Elyssa-IMDb Full Stack                          │
# ├──────────────────────────────────────────────────────────────────┤
# │ DE (Data Engineering)                                           │
# │   PostgreSQL .............. 5432 (internal) → 54321 (host)      │
# │   Neo4j HTTP .............. 7474 (internal) → 7475  (host)      │
# │   Neo4j Bolt .............. 7687 (internal) → 7688  (host)      │
# │   RustFS S3 API ........... 9000 (internal) → 9100  (host)      │
# │   RustFS Console .......... 9001 (internal) → 9101  (host)      │
# │   Airflow Web UI .......... 8080 (internal) → 8081  (host)      │
# │                                                                  │
# │ DS (Data Science)                                               │
# │   Jupyter Lab ............. 8888 (internal) → 8888  (host)      │
# │   MLflow UI .............. 5000 (internal) → 5001  (host)      │
# │   TensorBoard ............. 6006 (internal) → 6006  (host)      │
# │                                                                  │
# │ SWE (Web Application)                                           │
# │   FastAPI Backend ......... 8000 (internal) → 8000  (host)      │
# │   React Frontend (Vite) ... 5173 (internal) → 5173  (host)      │
# │   GraphQL Endpoint ........ 8000 (shared with FastAPI)          │
# │                                                                  │
# │ MLOps / Infrastructure                                          │
# │   Prometheus .............. 9090 (internal) → 9090  (host)      │
# │   Grafana ................. 3000 (internal) → 3000  (host)      │
# │   MinIO (S3) .............. 9000 (shared with RustFS)           │
# │   Redis ................... 6379 (internal) → 6380  (host)      │
# │   Kafka ................... 9092 (internal) → 9093  (host)      │
# └──────────────────────────────────────────────────────────────────┘

# ═══════════════════════════════════════════════════════════════════
# DE: Data Engineering Services
# ═══════════════════════════════════════════════════════════════════

# PostgreSQL + TimescaleDB
POSTGRES_USER=elyssa
POSTGRES_PASSWORD=elyssa_pg_2026
POSTGRES_DB=elyssa_warehouse
POSTGRES_PORT=54321

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=elyssa_neo4j_2026
NEO4J_HTTP_PORT=7475
NEO4J_BOLT_PORT=7688

# RustFS (S3-compatible object store — imdb-source/, bronze/, gold-exports/)
RUSTFS_ACCESS_KEY=elyssa
RUSTFS_SECRET_KEY=elyssa_s3_2026
RUSTFS_API_PORT=9100
RUSTFS_CONSOLE_PORT=9101
RUSTFS_BUCKETS=imdb-source,bronze,gold-exports

# S3 endpoint vars for DuckDB httpfs (used by all ETL containers)
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=elyssa
S3_SECRET_KEY=elyssa_s3_2026
S3_REGION=us-east-1

# Apache Airflow
AIRFLOW__WEBSERVER__SECRET_KEY=elyssa_airflow_secret_2026
AIRFLOW__CORE__FERNET_KEY=elyssa_fernet_key_2026
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@elyssa.local
AIRFLOW_PORT=8081

# ═══════════════════════════════════════════════════════════════════
# DS: Data Science Services
# ═══════════════════════════════════════════════════════════════════

# Jupyter Lab (Phase 2 — Duke's EDA + DS prototyping)
JUPYTER_PORT=8888
JUPYTER_TOKEN=elyssa_ds_2026

# MLflow Model Registry & UI (Phase 3)
MLFLOW_PORT=5001
MLFLOW_BACKEND_STORE=postgresql+psycopg2://elyssa:elyssa_pg_2026@postgres:5432/mlflow_db
MLFLOW_ARTIFACTS_BUCKET=mlflow-artifacts

# TensorBoard (Phase 3 — training visualization)
TENSORBOARD_PORT=6006

# ═══════════════════════════════════════════════════════════════════
# SWE: Web Application Services
# ═══════════════════════════════════════════════════════════════════

# FastAPI Backend (Phase 5)
FASTAPI_PORT=8000
FASTAPI_WORKERS=4

# React Frontend / Vite Dev Server (Phase 5)
VITE_PORT=5173
VITE_API_PROXY=http://localhost:8000

# ═══════════════════════════════════════════════════════════════════
# MLOps / Infrastructure Services
# ═══════════════════════════════════════════════════════════════════

# Prometheus (Phase 6 — metrics)
PROMETHEUS_PORT=9090

# Grafana (Phase 6 — dashboards)
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=elyssa_grafana_2026

# Redis (Phase 6 — caching / Celery broker)
REDIS_PORT=6380

# Kafka (Phase 6 — event streaming)
KAFKA_PORT=9093
KAFKA_INTERNAL_PORT=9092

# ═══════════════════════════════════════════════════════════════════
# General
# ═══════════════════════════════════════════════════════════════════
COMPOSE_PROJECT_NAME=elyssa
TZ=UTC
