# Elyssa-IMDb | Data Engineering Stack — Docker Images
# DuckDB — ephemeral analytical query engine for Bronze Parquet
# No persistent storage; runs in-memory and is created/destroyed on demand.

# ─── DuckDB (Python) ──────────────────────────────────────────────
# Purpose: Read Parquet files from Bronze layer, answer analytical queries
# Runtime: ephemeral — no volume, no restart
FROM python:3.13-slim-bookworm

# Install DuckDB
RUN pip install --no-cache-dir duckdb==1.5.4

# Health check: verify DuckDB can import and run a basic query
HEALTHCHECK --interval=10s --timeout=5s --retries=3 --start-period=5s \
    CMD python -c "import duckdb; conn = duckdb.connect(':memory:'); conn.execute('SELECT 1'); conn.close()"

# Default: keep alive for on-demand query execution via exec
CMD ["sleep", "infinity"]

EXPOSE 0
