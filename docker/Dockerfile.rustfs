# Elyssa-IMDb | Data Engineering Stack — Docker Images
# RustFS — S3-compatible object storage for Bronze layer (Parquet)

# ─── RustFS ────────────────────────────────────────────────────────
# Purpose: Bronze layer raw storage — append-only Parquet, Snappy-compressed
# Port: 9000 (S3 API), 9001 (admin console)
# P2-8: pinned tag (1.0.0-beta.12, matches the `latest` digest at pin time)
# to make builds reproducible; only bump deliberately.
FROM rustfs/rustfs:1.0.0-beta.12

# Download rc CLI (RustFS client) — base image runs as non-root, so elevate for install
USER root
ARG RC_VERSION=v0.1.30
ARG RC_URL=https://github.com/rustfs/cli/releases/download/${RC_VERSION}/rustfs-cli-linux-amd64-${RC_VERSION}.tar.gz
RUN wget -qO /tmp/rc.tar.gz ${RC_URL} \
    && tar -xzf /tmp/rc.tar.gz -C /usr/local/bin/ rc \
    && rm /tmp/rc.tar.gz
USER rustfs

# Environment
ENV RUSTFS_ACCESS_KEY=elyssa \
    RUSTFS_SECRET_KEY=elyssa_s3_2026 \
    RUSTFS_REGION=us-east-1 \
    RUSTFS_CONSOLE_ADDRESS=":9001"

# Create buckets at startup using rc CLI
COPY docker/rustfs/entrypoint.sh /tmp/entrypoint.sh

ENTRYPOINT ["/bin/sh", "/tmp/entrypoint.sh"]

HEALTHCHECK --interval=10s --timeout=5s --retries=10 --start-period=30s \
    CMD pgrep -x rustfs > /dev/null || exit 1

EXPOSE 9000 9001
