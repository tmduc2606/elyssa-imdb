# Elyssa-IMDb | ETL Runner — Dedicated DuckDB ETL Engine
# Has its own 6 GB budget so DuckDB heavy lifting doesn't
# compete with Airflow for memory.
# Only depends on: duckdb + psycopg2 (no webserver, no scheduler, no dbt)

FROM python:3.11-slim

RUN pip install --no-cache-dir \
    duckdb==1.1.3 \
    psycopg2-binary==2.9.10 \
    pyarrow==25.0.0 \
    pyyaml==6.0.3 \
    python-dotenv==1.0.1

ENV DUCKDB_THREADS=2 \
    DUCKDB_MEMORY_LIMIT=4GB

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=10s \
    CMD python -c "import duckdb; conn = duckdb.connect(':memory:'); conn.execute('SELECT 1'); conn.close()"

# Keep container alive for potential future use
CMD ["sleep", "infinity"]
