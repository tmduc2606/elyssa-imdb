# Elyssa-IMDb | ETL Runner — Dedicated DuckDB ETL Engine
# Runs Silver transform (UNNEST-heavy) on its own memory budget.
# DuckDB spills to DUCKDB_TEMP_DIR when memory is exhausted.
# Override limits via container env vars (docker-compose.yml).

FROM python:3.11-slim

RUN pip install --no-cache-dir \
    duckdb==1.1.3 \
    psycopg2-binary==2.9.10 \
    pyarrow==25.0.0 \
    requests==2.32.3 \
    pyyaml==6.0.3 \
    python-dotenv==1.0.1

ENV DUCKDB_THREADS=2 \
    DUCKDB_MEMORY_LIMIT=2GB \
    DUCKDB_TEMP_DIR=/tmp/duckdb_spill

RUN mkdir -p /tmp/duckdb_spill && chmod 777 /tmp/duckdb_spill

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=10s \
    CMD python -c "import duckdb; conn = duckdb.connect(':memory:'); conn.execute('SELECT 1'); conn.close()"

CMD ["sleep", "infinity"]
